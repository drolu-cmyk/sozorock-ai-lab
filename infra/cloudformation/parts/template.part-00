AWSTemplateFormatVersion: '2010-09-09'
Description: Private S3, CloudFront, secure application intake API, and email delivery for SozoRock AI Lab.

Parameters:
  SiteBucketName:
    Type: String
  DomainName:
    Type: String
    Default: ai-lab.sozorockfoundation.org
  CertificateArn:
    Type: String
    Default: ''
  HostedZoneId:
    Type: String
    Default: ''
  SenderEmail:
    Type: String
    Default: contact@sozorockfoundation.org
  InternalNotificationEmail:
    Type: String
    Default: contact@sozorockfoundation.org
  FullApplicationUrl:
    Type: String
    Default: ''
  AllowedOrigin:
    Type: String
    Default: https://ai-lab.sozorockfoundation.org
  ApplicationRateLimit:
    Type: Number
    Default: 5
    MinValue: 1
    MaxValue: 50
  ApplicationBurstLimit:
    Type: Number
    Default: 10
    MinValue: 1
    MaxValue: 100

Conditions:
  HasDomain: !Not [!Equals [!Ref DomainName, '']]
  HasCertificate: !Not [!Equals [!Ref CertificateArn, '']]
  HasHostedZone: !And [!Condition HasDomain, !Not [!Equals [!Ref HostedZoneId, '']]]

Resources:
  SiteBucket:
    Type: AWS::S3::Bucket
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      BucketName: !Ref SiteBucketName
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true
      OwnershipControls:
        Rules:
          - ObjectOwnership: BucketOwnerEnforced
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      VersioningConfiguration:
        Status: Enabled
      LifecycleConfiguration:
        Rules:
          - Id: ExpireNoncurrentVersions
            Status: Enabled
            NoncurrentVersionExpiration:
              NoncurrentDays: 30

  ApplicationsTable:
    Type: AWS::DynamoDB::Table
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      BillingMode: PAY_PER_REQUEST
      AttributeDefinitions:
        - AttributeName: id
          AttributeType: S
      KeySchema:
        - AttributeName: id
          KeyType: HASH
      TimeToLiveSpecification:
        AttributeName: ttl
        Enabled: true
      SSESpecification:
        SSEEnabled: true
      PointInTimeRecoverySpecification:
        PointInTimeRecoveryEnabled: true

  ApplicationsFunctionRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: lambda.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: applications-function-policy
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - logs:CreateLogStream
                  - logs:PutLogEvents
                Resource: !Sub 'arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-applications:*'
              - Effect: Allow
                Action: dynamodb:PutItem
                Resource: !GetAtt ApplicationsTable.Arn
              - Effect: Allow
                Action:
                  - ses:SendEmail
                  - ses:SendRawEmail
                Resource: !Sub 'arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/${SenderEmail}'

